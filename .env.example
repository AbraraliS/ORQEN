# ============================================================
# Orqen — Environment Variables Template
# ============================================================
#
# USAGE:
#   cp .env.example .env.local          # local dev
#   cp .env.example .env.production     # production (never commit!)
#
# This file is safe to commit — it contains NO real secrets.
# ============================================================

# ─── Nhost Frontend Connection ────────────────────────────────
# Local dev: "local" with empty region
# Cloud:     your Nhost app subdomain (e.g. "abcdefgh") + region (e.g. "eu-central-1")
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=

# ─── Hasura Admin Secret (server-side only, never expose to browser) ──
# Local dev: "nhost-admin-secret" (set in .nhost/docker-compose.yaml)
# Cloud:     set in your Nhost project secrets
HASURA_GRAPHQL_ADMIN_SECRET=nhost-admin-secret

# ─── Gemini AI (for LLM workflow steps) ──────────────────────
# Get your API key at: https://aistudio.google.com/apikey
# Set this also in .nhost/docker-compose.yaml under GEMINI_API_KEY
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Nhost Internal Secrets ──────────────────────────────────
NHOST_ADMIN_SECRET=nhost-admin-secret
NHOST_WEBHOOK_SECRET=nhost-webhook-secret

# ─── Next.js Security ────────────────────────────────────────
# Generate a strong random string for production:
#   openssl rand -hex 32
NEXTAUTH_SECRET=dev-secret-change-in-production
